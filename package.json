    "build:win": "node scripts/build.js win32",
    "build:mac": "node scripts/build.js darwin"
  },
  "dependencies": {
    "audify": "1.10.1",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.5.1"
  },
  "allowScripts": {
    "audify@1.10.1": true
  }
}
