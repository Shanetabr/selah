{
  "name": "selah",
  "productName": "Selah BETA",
  "version": "0.3.0-beta.1",
  "description": "Multitrack playback for live worship: stems, click, sections, dual-output routing.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/*.test.js\"",
